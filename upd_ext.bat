echo [1/4] Removing uncommitted changes...
git reset --hard HEAD || goto :fail
git clean -fd -e "%~nx0" || goto :fail

echo [2/4] Pulling latest source from GitHub...
git pull --ff-only origin main || goto :fail

echo [3/4] Installing Extension dependencies...
call npm ci --prefix extension || goto :fail

echo [4/4] Building Chrome Extension...
call npm run build --prefix extension || goto :fail