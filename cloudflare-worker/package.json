{
  "name": "researchtube-cloudflare-worker",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "check": "node scripts/export-catalog.mjs --check && node --import tsx scripts/build-validators.ts --check && node --import tsx scripts/auth-schema.ts --check && tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:chrome": "npm run build && node tests/chrome.integration.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:production": "wrangler deploy --env production --dry-run --outdir dist/production",
    "db:local": "wrangler d1 migrations apply researchtube --local",
    "db:remote": "wrangler d1 migrations apply researchtube --remote --env production",
    "catalog": "node scripts/export-catalog.mjs",
    "validators": "node --import tsx scripts/build-validators.ts",
    "schema": "node --import tsx scripts/auth-schema.ts",
    "prepare": "npm run generate",
    "generate": "npm run catalog && npm run validators"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.12",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "better-auth": "1.7.12",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "26.6.5",
    "miniflare": "5.20261019.2-beta",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22"
  }
}
