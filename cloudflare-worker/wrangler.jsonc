{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "researchtube",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "EXTENSION_ORIGINS": "[\"chrome-extension://jnnhjpkdhmghpbgfcalbhmkagdeelgnp\"]",
    "ALLOW_LOCAL_DEVELOPMENT": "true"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "researchtube",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "durable_objects": { "bindings": [{ "name": "BROWSER_ROOMS", "class_name": "BrowserRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BrowserRoom"] }],
  "env": {
    "production": {
      "name": "researchtube",
      "account_id": "bb4ba8acee199cf7da2a9aabddf2c8fd",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "rtube.win", "custom_domain": true }],
      "vars": {
        "PUBLIC_ORIGIN": "https://rtube.win",
        "EXTENSION_ORIGINS": "[\"chrome-extension://jnnhjpkdhmghpbgfcalbhmkagdeelgnp\"]",
        "ALLOW_LOCAL_DEVELOPMENT": "false"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "researchtube",
        "database_id": "4b5f3302-1cff-4f0f-8775-d2397084217d",
        "migrations_dir": "migrations"
      }],
      "durable_objects": { "bindings": [{ "name": "BROWSER_ROOMS", "class_name": "BrowserRoom" }] }
    }
  }
}
