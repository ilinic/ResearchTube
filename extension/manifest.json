{
  "manifest_version": 3,
  "name": "ResearchTube — YouTube Research for ChatGPT",
  "version": "2.2.0",
  "description": "Public YouTube research tools for ChatGPT through a local MCP connection.",
  "icons": {
    "16": "icons/researchtube-16.png",
    "32": "icons/researchtube-32.png",
    "48": "icons/researchtube-48.png",
    "128": "icons/researchtube-128.png"
  },
  "permissions": ["storage", "alarms", "tabs", "scripting", "offscreen", "clipboardWrite", "debugger"],
  "host_permissions": ["https://api.openai.com/*", "https://www.youtube.com/*", "https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_page": "onboarding.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ResearchTube",
    "default_icon": {
      "16": "icons/researchtube-16.png",
      "24": "icons/researchtube-24.png",
      "32": "icons/researchtube-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt-capture-frame-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
