{
  "manifest_version": 3,
  "minimum_chrome_version": "125",
  "name": "ResearchTube \u2014 YouTube Research for ChatGPT",
  "version": "2.10.4",
  "key": "",
  "description": "YouTube research and local media tools for ChatGPT.",
  "icons": {
    "16": "icons/researchtube-16.png",
    "32": "icons/researchtube-32.png",
    "48": "icons/researchtube-48.png",
    "128": "icons/researchtube-128.png"
  },
  "permissions": [
    "identity",
    "identity.email",
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "offscreen",
    "clipboardWrite",
    "debugger",
    "tabGroups"
  ],
  "host_permissions": [
    "https://rtube.win/*",
    "https://www.youtube.com/*",
    "https://translate.google.com/*",
    "https://chatgpt.com/*",
    "https://web-sandbox.oaiusercontent.com/*",
    "https://*.web-sandbox.oaiusercontent.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://rtube.win/*"
    ]
  },
  "options_page": "settings.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ResearchTube",
    "default_icon": {
      "16": "icons/researchtube-16.png",
      "24": "icons/researchtube-24.png",
      "32": "icons/researchtube-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://web-sandbox.oaiusercontent.com/*"
      ],
      "js": [
        "chatgpt-capture-frame-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://web-sandbox.oaiusercontent.com/*",
        "https://*.web-sandbox.oaiusercontent.com/*"
      ],
      "js": [
        "chatgpt-chat-target-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://web-sandbox.oaiusercontent.com/*",
        "https://*.web-sandbox.oaiusercontent.com/*"
      ],
      "js": [
        "chatgpt-image-viewer-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "media-viewer.html"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://web-sandbox.oaiusercontent.com/*"
      ]
    }
  ]
}
